{
  "name": "@raidiant/notifai-protocol",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "description": "Client-visible NotifAI wire contract: notification drafts, REST v1 request/response types, status vocabulary, and capability negotiation.",
  "license": "Apache-2.0",
  "author": "Rafael Vidaurre",
  "homepage": "https://github.com/RafaelVidaurre/notifai#readme",
  "bugs": {
    "url": "https://github.com/RafaelVidaurre/notifai/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelVidaurre/notifai.git",
    "directory": "packages/protocol"
  },
  "keywords": [
    "notifai",
    "protocol",
    "typebox",
    "notifications"
  ],
  "files": [
    "dist",
    "src",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=20"
  }
}
