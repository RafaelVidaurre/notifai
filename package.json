{
  "name": "notifai-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:boundary:self-test": "node scripts/check-boundary.mjs --self-test",
    "check:release": "node scripts/check-release.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
